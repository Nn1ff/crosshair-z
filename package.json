{
  "name": "crosshair-z",
  "productName": "Crosshair Z",
  "version": "2.0.0",
  "description": "Shared UI, assets and development tools for the native Rust Crosshair Z runtime",
  "author": "Nn1ff",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "cargo run --manifest-path native/app/Cargo.toml",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File native/app/scripts/package.ps1",
    "build:pack": "node scripts/build-default-pack.js",
    "export:native": "node scripts/export-native-defaults.js",
    "capture": "node scripts/capture-native.js",
    "test:native-ui": "node scripts/native-settings-e2e.js"
  },
  "devDependencies": {
    "playwright-core": "^1.48.2"
  }
}
