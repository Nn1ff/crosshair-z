{
  "name": "crosshair-z",
  "productName": "Crosshair Z",
  "version": "1.8.4",
  "description": "Crosshair Z",
  "main": "src/main/main.js",
  "author": "Nn1ff",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win portable",
    "build:pack": "node scripts/build-default-pack.js"
  },
  "build": {
    "appId": "com.crosshairz.app",
    "directories": {
      "output": "release"
    },
    "productName": "Crosshair Z",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/splash.bmp",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64){,/**}",
      "!node_modules/koffi/build/koffi/win32_x64/*.{exp,lib}",
      "!node_modules/koffi/{doc,src,vendor,lib}{,/**}"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "electronLanguages": [
      "en-US"
    ],
    "portable": {
      "splashImage": "assets/splash.bmp"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  }
}
